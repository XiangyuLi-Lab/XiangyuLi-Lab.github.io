{
  "name": "xylab-activities",
  "private": true,
  "scripts": {
    "build:home": "esbuild src/home/main.tsx --bundle --format=esm --platform=browser --jsx=automatic --minify --outfile=static/home/hero.js --define:process.env.NODE_ENV=\"\\\"production\\\"\"",
    "build:news": "esbuild src/home/news.tsx --bundle --format=esm --platform=browser --jsx=automatic --minify --outfile=static/home/news.js --define:process.env.NODE_ENV=\"\\\"production\\\"\"",
    "build:activities": "esbuild src/activities/main.tsx --bundle --format=esm --platform=browser --jsx=automatic --minify --outfile=static/activities/carousel.js --define:process.env.NODE_ENV=\"\\\"production\\\"\"",
    "check:activities": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
